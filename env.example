# Firebase Configuration (Required for production)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# JWT Secret (for additional security if needed)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database URLs (for future use)
DATABASE_URL=postgresql://user:password@localhost:5432/fastcare
REDIS_URL=redis://localhost:6379

# Vercel Deployment Instructions:
# 1. Go to https://vercel.com
# 2. Sign up with GitHub
# 3. Import your FastCare repository
# 4. Add these environment variables in Vercel dashboard
# 5. Deploy automatically on every git push
